{
  "diagnostics": {
    "lsp_pull_diagnostics": {
      "enabled": true
    },
    "inline": {
      "enabled": true
    }
  },
  "diagnostics_max_severity": "off",
  "disable_ai": true,
  "prettier": {
    "allowed": false
  },
  "semantic_tokens": "combined",
  "code_lens": "menu",
  "format_on_save": "on",
  "vim": {
    "cursor_shape": {
      "insert": "bar"
    },
    "use_smartcase_find": false,
    "toggle_relative_line_numbers": false
  },
  "toolbar": {
    "code_actions": false
  },
  "minimap": {
    "max_width_columns": 80,
    "thumb": "always",
    "show": "never"
  },
  "scroll_sensitivity": 2.0,
  "unnecessary_code_fade": 0.3,
  "cursor_blink": false,
  "cursor_animation": {
    "enabled": false
  },
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 300.0,
  "which_key": {
    "delay_ms": 1000,
    "enabled": true
  },
  "tabs": {
    "file_icons": false,
    "git_status": false
  },
  "title_bar": {
    "show_branch_status_icon": false
  },
  "status_bar": {
    "show_active_file": true
  },
  "use_smartcase_search": true,
  "proxy": "",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "icon_theme": "Catppuccin Latte",
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 13.5,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
}
